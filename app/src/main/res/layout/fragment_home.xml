<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F5F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ═══════════════ HERO HEADER ═══════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="175dp"
            android:orientation="vertical"
            android:background="@drawable/bg_gradient_green"
            android:paddingHorizontal="22dp"
            android:paddingTop="26dp"
            android:paddingBottom="46dp">

            <!-- Top row: welcome + language toggle + sign out -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/good_day"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"
                        android:textColor="#D9FFFFFF" />

                    <TextView
                        android:id="@+id/tvWelcomeName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_resident"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="24sp"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLanguageToggle"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/lang_toggle_text"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#88FFFFFF"
                    app:cornerRadius="18dp" />

                <ImageButton
                    android:id="@+id/btnSignOut"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/ic_lock_power_off"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:tint="#FFFFFF"
                    android:contentDescription="Sign Out" />

            </LinearLayout>

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_subtitle"
                android:fontFamily="sans-serif"
                android:textSize="14sp"
                android:textColor="#D9FFFFFF"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ═══════════════ FLOATING CARDS SECTION ═══════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="-24dp"
            android:paddingHorizontal="16dp">

            <!-- TRACTOR STATUS CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTractorStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="16dp">
                        <View
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/shape_dot_green_circle" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🚜"
                            android:textSize="24sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/collection_vehicle"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="10sp"
                            android:textColor="#9E9E9E"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tvHomeTractorStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/waiting_signal"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="17sp"
                            android:textColor="#1B5E20"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvHomeTractorDist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="sans-serif"
                            android:textSize="13sp"
                            android:textColor="#757575"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenMap"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/track_now"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="13sp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#2E7D32" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══════════════ COMMUNITY IMPACT CARD ═══════════════ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#E8F5E9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Title Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_community"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/community_impact_title"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="13sp"
                            android:textColor="#1B5E20"
                            android:letterSpacing="0.03" />
                    </LinearLayout>

                    <!-- Big stat -->
                    <TextView
                        android:id="@+id/tvCommunityTons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/community_impact_tons"
                        android:fontFamily="sans-serif-black"
                        android:textSize="38sp"
                        android:textColor="#1B5E20" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/community_impact_desc"
                        android:fontFamily="sans-serif"
                        android:textSize="13sp"
                        android:textColor="#33691E"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/community_impact_tagline"
                        android:fontFamily="sans-serif"
                        android:textStyle="italic"
                        android:textSize="12sp"
                        android:textColor="#388E3C"
                        android:layout_marginBottom="14dp" />

                    <!-- CO2 sub-card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="14dp">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_marginEnd="12dp">
                                <View
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/shape_dot_green_circle" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="🌲"
                                    android:textSize="18sp" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/co2_saved_label"
                                    android:fontFamily="sans-serif"
                                    android:textSize="11sp"
                                    android:textColor="#9E9E9E" />

                                <TextView
                                    android:id="@+id/tvCo2Saved"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/co2_saved_value"
                                    android:fontFamily="sans-serif-medium"
                                    android:textSize="16sp"
                                    android:textColor="#1B5E20" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ward_residents"
                                android:fontFamily="sans-serif"
                                android:textSize="11sp"
                                android:textColor="#757575" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- COLLECTION SCHEDULE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅"
                            android:textSize="18sp"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/collection_schedule"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="16sp"
                            android:textColor="#212121" />
                    </LinearLayout>

                    <!-- Wet Waste Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/shape_schedule_row"
                        android:paddingHorizontal="14dp"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/wet_waste_label"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:textColor="#2E7D32" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/schedule_wet"
                            android:fontFamily="sans-serif"
                            android:textSize="13sp"
                            android:textColor="#388E3C" />
                    </LinearLayout>

                    <!-- Dry Waste Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/shape_schedule_row"
                        android:paddingHorizontal="14dp"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/dry_waste_label"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:textColor="#1565C0" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/schedule_dry"
                            android:fontFamily="sans-serif"
                            android:textSize="13sp"
                            android:textColor="#1976D2" />
                    </LinearLayout>

                    <!-- Plastic Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/shape_schedule_row"
                        android:paddingHorizontal="14dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/plastic_waste_label"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:textColor="#E65100" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/schedule_plastic"
                            android:fontFamily="sans-serif"
                            android:textSize="13sp"
                            android:textColor="#F57C00" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TIP CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#E8F5E9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="20sp"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DID YOU KNOW?"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="10sp"
                            android:textColor="#2E7D32"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="3dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/notif_tip"
                            android:fontFamily="sans-serif"
                            android:textSize="13sp"
                            android:textColor="#33691E" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>