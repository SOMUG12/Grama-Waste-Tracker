<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_report.xml  →  app/src/main/res/layout/fragment_report.xml

    ALL text is now via @string/ references so the layout automatically
    switches to Kannada when the user picks ಕನ್ನಡ.
    Icons: ic_camera_plus in photo zone, ic_recycle on General Waste chip.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="32dp">

        <!-- ── Header ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_title"
            android:fontFamily="sans-serif-medium"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1B3022"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/report_subtitle_long"
            android:textSize="14sp"
            android:textColor="#5A6B5F"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="20dp" />

        <!-- ── Photo Upload Zone (tappable card) ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPhotoZone"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#ECF0EC"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#B0BDB0"
            app:strokeWidth="1.5dp"
            android:foreground="?attr/selectableItemBackground">

            <!-- Placeholder: camera+ icon in green circle + label -->
            <LinearLayout
                android:id="@+id/layoutPhotoPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Green circle with camera+ icon inside -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="14dp">

                    <View
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/shape_logo_circle" />

                    <!-- ★ Camera+ icon -->
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_camera_plus"
                        android:tint="#1B3022" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/photo_zone_label"
                    android:textSize="11sp"
                    android:textColor="#5A6B5F"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.10" />
            </LinearLayout>

            <!-- Image preview shown after photo is selected -->
            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ── Detected Location Card (visible after photo is picked) ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutMetadata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Green pin circle -->
                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp">

                    <View
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/shape_dot_green_circle" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_map"
                        android:tint="#386641" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detected_location_label"
                        android:textSize="11sp"
                        android:textColor="#5A6B5F"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#1B3022"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/edit_label"
                    android:textSize="13sp"
                    android:textColor="#386641"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Timestamp — hidden, kept for data layer only -->
        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- ── Additional Details (Optional) ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/additional_details_label"
            android:textSize="13sp"
            android:textColor="#1B3022"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <EditText
                android:id="@+id/etDetails"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/additional_details_hint"
                android:padding="16dp"
                android:textSize="14sp"
                android:textColor="#1B3022"
                android:textColorHint="#A0ABA2"
                android:inputType="textMultiLine"
                android:lines="4"
                android:maxLines="4"
                android:scrollbars="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Waste Category Chips ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/waste_category_label"
            android:textSize="13sp"
            android:textColor="#1B3022"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <!-- ★ General Waste — recycle icon -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipGeneral"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_general_waste"
                android:checked="true"
                app:chipCornerRadius="20dp"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipStrokeColor="@color/chip_stroke_selector"
                app:chipStrokeWidth="1.5dp"
                app:checkedIconEnabled="false"
                app:chipIcon="@drawable/ic_recycle"
                app:chipIconTint="@color/chip_text_selector"
                app:chipIconSize="18dp"
                android:textColor="@color/chip_text_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHazardous"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_hazardous"
                app:chipCornerRadius="20dp"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipStrokeColor="@color/chip_stroke_selector"
                app:chipStrokeWidth="1.5dp"
                app:checkedIconEnabled="false"
                android:textColor="@color/chip_text_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipConstruction"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_construction"
                app:chipCornerRadius="20dp"
                app:chipBackgroundColor="@color/chip_bg_selector"
                app:chipStrokeColor="@color/chip_stroke_selector"
                app:chipStrokeWidth="1.5dp"
                app:checkedIconEnabled="false"
                android:textColor="@color/chip_text_selector" />

        </com.google.android.material.chip.ChipGroup>

        <!-- ── Progress Indicator ── -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressUpload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="#386641"
            app:trackColor="#C8E6C9" />

        <!-- ── Submit Button ── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_submit_report_arrow"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.01"
            app:backgroundTint="#204e2b"
            app:cornerRadius="30dp"
            app:elevation="4dp" />

        <!-- Change Photo — shown only after photo is selected -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUploadPhoto"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_change_photo"
            android:visibility="gone"
            app:cornerRadius="30dp"
            app:strokeColor="#386641"
            android:textColor="#386641"
            android:layout_marginBottom="8dp" />

        <!-- ── Success Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="#E8F5E9"
            app:cardCornerRadius="20dp"
            app:strokeColor="#A5D6A7"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅"
                    android:textSize="28sp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/report_success_title"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#1B5E20"
                        android:layout_marginBottom="2dp" />

                    <TextView
                        android:id="@+id/tvSuccessDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/report_success_detail"
                        android:textSize="13sp"
                        android:textColor="#2E7D32" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>